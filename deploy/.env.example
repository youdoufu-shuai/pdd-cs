# ---------------------------------------------------------------------------
# 部署环境变量示例：
#   cp deploy/.env.example deploy/.env
#   修改 PDD_CS_AUTH_TOKEN（必填）、PDD_CS_PORT（可选）
# ---------------------------------------------------------------------------

# 面板端口：默认 38617（少见高位端口），可改成你想要的任何值
PDD_CS_PORT=38617

# 面板访问令牌：容器内绑定 0.0.0.0，必须设置
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
PDD_CS_AUTH_TOKEN=please-change-me-to-a-long-random-token

# 大模型 Key（不配则只用关键词/默认回复）
# PDD_CS_LLM_KEY=sk-xxxx

# 日志级别（DEBUG / INFO / WARNING）
PDD_CS_LOG_LEVEL=INFO
